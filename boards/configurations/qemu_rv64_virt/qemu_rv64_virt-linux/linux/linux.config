#
# Kconfig fragment, applied on top of `tinyconfig`, for a minimal RV64 Linux
# kernel running as an S-mode SBI guest of Tock. The guest has no devices: it
# uses the SBI for its console and timer only.

CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_RISCV_ISA_V=n
CONFIG_EFI=n

# Console & logging through the SBI
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
# The SBI console drivers are only available in non-portable kernels.
CONFIG_NONPORTABLE=y
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_KALLSYMS=y
CONFIG_BUG=y

# Userspace: a single static init in a built-in initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
# CONFIG_INITRAMFS_SOURCE is set by build-linux.sh.
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_MULTIUSER=y

# Timers
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
