include ../../Makefile.common

BINDGEN ?= bindgen

# Regenerates src/bindings.rs from the Nordic headers carried by the
# tock-firmware-nrf-sdc dependency. The result is committed, so building this
# board needs neither bindgen nor libclang; only updating nrfxlib does.
#
# The target triple has to match the one the libraries were built for, since
# the generated types are used for their sizes.
.PHONY: bindings
bindings:
	inc="$$(dirname "$$($(CARGO) metadata --format-version 1 | python3 -c \
	    'import json,sys; print(next(p["manifest_path"] for p in json.load(sys.stdin)["packages"] \
	     if p["name"] == "tock-firmware-nrf-sdc"))')")/resources/include"; \
	  echo "  BINDGEN src/bindings.rs (headers: $$inc)"; \
	  $(BINDGEN) bindgen/wrapper.h \
	    --output src/bindings.rs \
	    --raw-line '// Generated by `make bindings` from the nrfxlib headers in the' \
	    --raw-line '// tock-firmware-nrf-sdc crate. Do not edit.' \
	    --raw-line '//' \
	    --raw-line '// Derived from headers copyright (c) Nordic Semiconductor ASA.' \
	    --raw-line '// SPDX-License-Identifier: LicenseRef-Nordic-5-Clause' \
	    $$(sed -e 's/#.*//' -e '/^[[:space:]]*$$/d' bindgen/flags) \
	    -- --target=$(TARGET) \
	    -I"$$inc/softdevice_controller" -I"$$inc/mpsl" -I"$$inc/stub"
